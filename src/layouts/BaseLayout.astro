---
import '../styles/global.css';

interface Props {
  lang: 'ko' | 'en';
  title: string;
  description: string;
  path: string; // 언어 전환 대상 경로 (예: '/' <-> '/en/')
}
const { lang, title, description, path } = Astro.props as Props;
---
<!DOCTYPE html>
<html lang={lang === 'ko' ? 'ko' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(path, Astro.site).toString()} />
  <script is:inline>
    // 테마 결정은 렌더 전에 끝내야 깜빡임(FOUC)이 없다.
    // localStorage 접근이 막혀 있어도(사파리 사생활 모드 등) 시스템 설정으로 폴백한다.
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      var theme = stored === 'light' || stored === 'dark'
        ? stored
        : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body data-lang={lang}>
  <a class="skip-link" href="#main">{lang === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}</a>
  <slot />
  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    })();
  </script>
</body>
</html>

---
// Material Symbols 대신 쓰는 인라인 SVG 아이콘(스펙이 Roboto·Noto Sans KR만
// 지정해 아이콘 폰트를 추가하지 않기로 했다. 아이콘 폰트 로드 실패 시 "download"
// 같은 리거처 텍스트가 그대로 노출되는 문제도 피한다).
interface Props {
  name: 'mail' | 'room' | 'call' | 'download' | 'arrow_outward' | 'chevron' | 'sun' | 'moon' | 'award';
  class?: string;
}
const { name, class: cls = '' } = Astro.props as Props;
---
{name === 'mail' && (
  <svg class={`icon ${cls}`} viewBox="0 0 24 24"><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/><path d="m4 6 8 7 8-7"/></svg>
)}
{name === 'room' && (
  <svg class={`icon ${cls}`} viewBox="0 0 24 24"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
)}
{name === 'call' && (
  <svg class={`icon ${cls}`} viewBox="0 0 24 24"><path d="M5 4h3.5l1.5 4.5-2 1.5a11 11 0 0 0 6 6l1.5-2 4.5 1.5V19a1 1 0 0 1-1 1C10.6 20 4 13.4 4 5a1 1 0 0 1 1-1Z"/></svg>
)}
{name === 'download' && (
  <svg class={`icon ${cls}`} viewBox="0 0 24 24"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 19h16"/></svg>
)}
{name === 'arrow_outward' && (
  <svg class={`icon ${cls}`} viewBox="0 0 24 24"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
)}
{name === 'chevron' && (
  <svg class={`icon ${cls}`} viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
)}
{name === 'sun' && (
  <svg class={`icon icon-sun ${cls}`} viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
)}
{name === 'moon' && (
  <svg class={`icon icon-moon ${cls}`} viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
)}
{name === 'award' && (
  <svg class={`icon ${cls}`} viewBox="0 0 24 24" width="13" height="13"><circle cx="12" cy="9" r="5"/><path d="m8 13-1.5 7L12 17l5.5 3L16 13"/></svg>
)}

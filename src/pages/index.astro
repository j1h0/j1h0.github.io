---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Research from '../components/Research.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Publications from '../components/Publications.astro';
import Projects from '../components/Projects.astro';
import ActivitiesCerts from '../components/ActivitiesCerts.astro';
import ContactFooter from '../components/ContactFooter.astro';
import { prepare } from '../lib/prepare.js';

const { t, updated, stats, selectedPubs, pubYears, ongoingProjects, closedProjects, intlMeta } = prepare('ko');
---
<BaseLayout lang="ko" path="/" title="신지호 | Jiho Shin, Ph.D." description={t.intro}>
  <Header t={t} lang="ko" otherLangPath="/en/" />
  <main id="main">
    <Hero t={t} />
    <Research t={t} />
    <CareerTimeline t={t} />
    <Publications t={t} lang="ko" stats={stats} selectedPubs={selectedPubs} pubYears={pubYears} />
    <Projects t={t} lang="ko" ongoingProjects={ongoingProjects} closedProjects={closedProjects} intlMeta={intlMeta} />
    <ActivitiesCerts t={t} />
    <ContactFooter t={t} updated={updated} lang="ko" />
  </main>
</BaseLayout>
